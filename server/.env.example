# 服务监听
PORT=8787

# MySQL 连接
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=momentswriter
DB_PASSWORD=请改成强密码
DB_NAME=moments_writer

# JWT 签名密钥(随机长字符串, 不能泄露)
JWT_SECRET=请用 openssl rand -hex 32 生成
JWT_EXPIRES_IN=7d

# 默认管理员账号(仅 init-db 时使用一次)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=请改成强密码

# 图片上传
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=5

# CORS 允许的来源(* 表示允许全部, 生产环境建议精确指定)
CORS_ORIGIN=*

# 公网访问的基础 URL(用于拼接图片绝对路径), 例如 http://154.219.116.29:8787
PUBLIC_BASE_URL=
